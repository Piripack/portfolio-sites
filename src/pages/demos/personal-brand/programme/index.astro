---
import Base from "../../../../layouts/Base.astro";
---
<Base title="CareerLift Programme" description="Inside the CareerLift Coaching programme." breadcrumbs={[{ label: 'Home', href: '/portfolio-sites/' }, { label: 'CareerLift Coaching', href: '/portfolio-sites/demos/personal-brand/' }, { label: 'Programme' }]}>
  <article class="mx-auto max-w-3xl space-y-6 text-neutral-600 dark:text-neutral-200">
    <h1 class="text-3xl font-bold text-neutral-900 dark:text-white" data-i18n="coaching.programme.heading">Programme outline</h1>
    <ol class="list-decimal space-y-3 pl-6">
      <li data-i18n="coaching.programme.stepPositioning">Positioning Sprint: Clarify your value proposition and leadership narrative.</li>
      <li data-i18n="coaching.programme.stepVisibility">Visibility Sprint: Optimise LinkedIn, craft outreach, and build referral systems.</li>
      <li data-i18n="coaching.programme.stepInterview">Interview Sprint: Role-play interviews, salary negotiations, and stakeholder presentations.</li>
    </ol>
    <p>Each week includes a 60-minute coaching session, on-demand feedback, and accountability check-ins.</p>
  </article>
</Base>
