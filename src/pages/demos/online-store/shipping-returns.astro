---
import Base from "../../../layouts/Base.astro";
---
<Base title="Shipping & Returns" description="Nordic Threads shipping and returns policies." breadcrumbs={[{ label: 'Home', href: '/portfolio-sites/' }, { label: 'Nordic Threads', href: '/portfolio-sites/demos/online-store/' }, { label: 'Shipping & returns' }]}>
  <article class="mx-auto max-w-3xl space-y-6 text-neutral-600 dark:text-neutral-200">
    <h1 class="text-3xl font-bold text-neutral-900 dark:text-white" data-i18n="store.shipping.heading">Shipping & returns</h1>
    <p>We ship nationwide using carbon-neutral partners.</p>
    <ul class="space-y-2">
      <li data-i18n="store.shipping.standard"><strong>Standard:</strong> £4.95, free over £150, delivered in 3-5 working days.</li>
      <li data-i18n="store.shipping.express"><strong>Express:</strong> £9.95 next-day delivery on orders placed before 3pm.</li>
      <li data-i18n="store.shipping.returns"><strong>Returns:</strong> Free returns within 30 days. Items must be unworn with tags.</li>
    </ul>
  </article>
</Base>
