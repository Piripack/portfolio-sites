---
import Base from "../../../layouts/Base.astro";
---
<Base title="Book a Table" description="Reserve a table at La Terra Café." breadcrumbs={[{ label: 'Home', href: '/portfolio-sites/' }, { label: 'La Terra Café', href: '/portfolio-sites/demos/restaurant/' }, { label: 'Book a table' }]}>
  <section class="space-y-6">
    <h1 class="text-3xl font-bold" data-i18n="restaurant.book.heading">Reserve a table</h1>
    <p class="text-neutral-600 dark:text-neutral-200" data-i18n="restaurant.book.lead">Use the embedded Google Form to request a booking. A member of the team will confirm within one hour during opening times.</p>
    <iframe
      src="https://docs.google.com/forms/d/e/1FAIpQLSdJ/book/viewform?embedded=true"
      width="100%"
      height="700"
      title="Book a table"
      class="w-full rounded-3xl border-0 bg-white shadow-lg dark:bg-neutral-900"
    >
      Loading…
    </iframe>
  </section>
</Base>
