---
import Base from "../../../layouts/Base.astro";
import CTA from "../../../components/astro/CTA.astro";

const breadcrumbs = [
  { label: 'Home', href: '/portfolio-sites/' },
  { label: 'La Terra Café' }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: 'La Terra Café',
  servesCuisine: 'Italian',
  priceRange: '££',
  telephone: '+441612223334'
};
---
<Base title="La Terra Café" description="Italian-inspired café in Manchester Northern Quarter." breadcrumbs={breadcrumbs} structuredData={structuredData}>
  <section class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
    <div class="space-y-6">
      <h1 class="text-4xl font-bold" data-i18n="restaurant.hero.title">Day-to-night dining with seasonal produce.</h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-200" data-i18n="restaurant.hero.subtitle">La Terra Café pairs single-origin coffee with an evening menu inspired by the Amalfi coast. Walk-ins welcome, bookings recommended after 5pm.</p>
      <div class="flex flex-wrap gap-4">
        <CTA href="/portfolio-sites/demos/restaurant/menu/" label="View menu" i18nKey="action.viewMenu" />
        <CTA href="https://forms.gle/1y6TTzN4Y" label="Book a table" variant="secondary" i18nKey="action.bookTable" />
      </div>
      <div class="flex items-center gap-3">
        <span class="rounded-full bg-green-600 px-3 py-1 text-xs font-semibold text-white" data-open-now data-i18n="restaurant.hero.badgeOpen">Open now</span>
        <script type="module" src="/portfolio-sites/scripts/open-now.js"></script>
        <p class="text-sm text-neutral-600 dark:text-neutral-300" data-i18n="restaurant.hero.badgeNote">Based on today's opening hours.</p>
      </div>
    </div>
    <aside class="rounded-3xl bg-white p-6 shadow-lg dark:bg-neutral-900">
      <h2 class="text-xl font-semibold" data-i18n="heading.openingHours">Opening hours</h2>
      <ul class="mt-3 space-y-2 text-sm text-neutral-600 dark:text-neutral-300">
        <li>Monday–Thursday: 08:00–22:00</li>
        <li>Friday: 08:00–23:00</li>
        <li>Saturday: 09:00–23:00</li>
        <li>Sunday: 09:00–18:00</li>
      </ul>
    </aside>
  </section>

  <section class="mt-16 grid gap-6 md:grid-cols-3">
    <article class="rounded-3xl bg-primary/10 p-6" data-reveal>
      <h2 class="text-xl font-semibold" data-i18n="menu.course.breakfast">Breakfast</h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-200" data-i18n="restaurant.sections.breakfastDesc">Freshly baked pastries, slow-fermented sourdough, and seasonal fruit.</p>
    </article>
    <article class="rounded-3xl bg-primary/10 p-6" data-reveal>
      <h2 class="text-xl font-semibold" data-i18n="menu.course.lunch">Lunch</h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-200" data-i18n="restaurant.sections.lunchDesc">Ciabatta panini, vibrant salads, and hearty soups.</p>
    </article>
    <article class="rounded-3xl bg-primary/10 p-6" data-reveal>
      <h2 class="text-xl font-semibold" data-i18n="menu.course.dinner">Dinner</h2>
      <p class="text-sm text-neutral-600 dark:text-neutral-200" data-i18n="restaurant.sections.dinnerDesc">House-made pasta, sharing plates, and low-intervention wines.</p>
    </article>
  </section>
</Base>
