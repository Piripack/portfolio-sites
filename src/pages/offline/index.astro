---
import Base from "../../layouts/Base.astro";
---
<Base title="Offline" description="You are viewing the offline fallback.">
  <section class="mx-auto max-w-md text-center">
    <h1 class="text-3xl font-bold">You are offline</h1>
    <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-300">
      No internet connection detected. Once you are back online, refresh to continue exploring our demos.
    </p>
  </section>
</Base>
