---
const { items = [] } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm" data-reveal>
  <ol class="flex flex-wrap items-center gap-2 text-neutral-500 dark:text-neutral-300">
    {items.map((item, index) => (
      <li class="flex items-center gap-2" aria-current={index === items.length - 1 ? 'page' : undefined}>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href && index !== items.length - 1 ? (
          <a class="underline-offset-4 hover:underline" href={item.href}>{item.label}</a>
        ) : (
          <span class="font-semibold text-neutral-900 dark:text-white">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
