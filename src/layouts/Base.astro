---
import '../styles/global.css';
import { Header } from '../components/react/Header';
import { CartProvider } from '../components/react/CartContext';
import { ToastProvider } from '../components/react/Toast';
const { title = 'Portfolio Sites', description = 'Production-grade Astro demos for UK service brands.', canonical, breadcrumbs = [], structuredData } = Astro.props;
const siteUrl = new URL(Astro.site ?? 'https://example.github.io/portfolio-sites/');
const canonicalUrl = canonical ?? new URL(Astro.request.url).href;
---
<!DOCTYPE html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Poppins:wght@500;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Poppins:wght@500;700&display=swap" media="print" onload="this.media='all'" />
    <script type="module" src="/portfolio-sites/scripts/i18n.js"></script>
    <link rel="manifest" href="/portfolio-sites/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/portfolio-sites/assets/icons/icon.svg" type="image/svg+xml" />
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"demo-token"}'></script>
    <script type="application/ld+json">{JSON.stringify(structuredData ?? {})}</script>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/portfolio-sites/scripts/service-worker.js', { scope: '/portfolio-sites/' });
        });
      }
    </script>
  </head>
  <body class="bg-base text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <a
      href="#content"
      class="absolute left-1/2 z-50 -translate-x-1/2 -translate-y-full rounded-full bg-primary px-4 py-2 text-white focus-visible:translate-y-4"
      data-i18n="skip.link"
    >
      Skip to content
    </a>
    <CartProvider>
      <ToastProvider>
        <Header client:load />
        {breadcrumbs.length > 0 && (await import('../components/astro/Breadcrumb.astro')).default({ items: breadcrumbs })}
        <main id="content" class="mx-auto max-w-6xl px-4 py-12">
          <slot />
        </main>
        <footer class="bg-neutral-900 py-12 text-neutral-200">
          <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 md:flex-row md:justify-between">
            <div>
              <h2 class="text-lg font-semibold" data-i18n="site.name">portfolio-sites</h2>
              <p class="mt-2 max-w-xs text-sm text-neutral-300" data-i18n="site.tagline">
                Accessible, high-performance Astro builds tailored for UK service brands.
              </p>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest" data-i18n="footer.stayInTouch">Stay in touch</p>
              <ul class="mt-3 space-y-2 text-sm">
                <li><a class="hover:underline" href="mailto:hello@example.co.uk" data-i18n="footer.email">hello@example.co.uk</a></li>
                <li><a class="hover:underline" href="tel:+441234567890" data-i18n="footer.phone">+44 1234 567 890</a></li>
              </ul>
            </div>
            <div>
              <p class="text-sm font-semibold uppercase tracking-widest" data-i18n="footer.legal">Legal</p>
              <ul class="mt-3 space-y-2 text-sm">
                <li><a class="hover:underline" href="/portfolio-sites/robots.txt" data-i18n="footer.robots">Robots</a></li>
                <li><a class="hover:underline" href="/portfolio-sites/sitemap.xml" data-i18n="footer.sitemap">Sitemap</a></li>
              </ul>
            </div>
          </div>
          <p class="mt-8 text-center text-xs text-neutral-500">
            © {new Date().getFullYear()} <span data-i18n="site.name">portfolio-sites</span>. <span data-i18n="footer.crafted">Crafted in Manchester.</span>
          </p>
        </footer>
      </ToastProvider>
    </CartProvider>
    <div class="fixed bottom-0 left-0 right-0 z-50 flex justify-around bg-primary px-4 py-3 text-sm font-semibold text-white md:hidden">
      <a href="tel:+441234567890" class="flex items-center gap-2" data-analytics="cta-call" data-i18n="cta.call">📞 Call</a>
      <a href="https://wa.me/441234567890" class="flex items-center gap-2" data-analytics="cta-whatsapp" data-i18n="cta.whatsapp">💬 WhatsApp</a>
      <a href="#contact" class="flex items-center gap-2" data-analytics="cta-quote" data-i18n="cta.quote">📝 Quote</a>
    </div>
    <script type="module" src="/portfolio-sites/scripts/observe.js"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('[data-analytics]').forEach((el) => {
          const handler = (eventName) => {
            if (eventName && window.__cfBeacon) {
              window.__cfBeacon.logEvent?.('custom', { event: eventName });
            }
          };
          if (el instanceof HTMLFormElement) {
            el.addEventListener('submit', () => handler(el.getAttribute('data-analytics')));
          } else {
            el.addEventListener('click', () => handler(el.getAttribute('data-analytics')));
          }
        });
      });
    </script>
  </body>
</html>
